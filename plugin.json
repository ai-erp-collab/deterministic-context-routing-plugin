{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "context-routing",
  "version": "0.3.0",
  "description": "Deterministic Context Routing: a file-based workspace that gives your coding agent exactly the context it needs in a large codebase and keeps its thread across sessions.",
  "author": {
    "name": "ai-erp-collab",
    "email": "tolstolutskyy@gmail.com"
  },
  "homepage": "https://github.com/ai-erp-collab/deterministic-context-routing-plugin",
  "repository": "https://github.com/ai-erp-collab/deterministic-context-routing-plugin",
  "license": "MIT",
  "keywords": [
    "context-engineering",
    "agent-skills",
    "ai-agents",
    "documentation",
    "knowledge-base"
  ],
  "extensions": {
    "com.openai": {
      "hooks": {},
      "interface": {
        "displayName": "Context Routing",
        "shortDescription": "Deterministic Context Routing: exact context for your agent in a large codebase, and session continuity.",
        "developerName": "ai-erp-collab",
        "category": "Developer Tools",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Turn this repo into a context-routing workspace.",
          "Add a module for src/billing."
        ],
        "websiteURL": "https://github.com/ai-erp-collab/deterministic-context-routing-plugin",
        "logo": "./.claude-plugin/icon.png"
      }
    }
  }
}
